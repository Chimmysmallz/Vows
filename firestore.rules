rules_version = '2';

// Vows.ng — Firestore security rules
//
// The governing rule: a wedding page is PUBLIC. Anyone with the link can read
// weddings/{slug}. Everything private therefore lives in a subcollection that
// is never publicly readable. Client-side hiding is decoration; this file is
// the actual boundary.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function wedding(slug) {
      return get(/databases/$(database)/documents/weddings/$(slug)).data;
    }

    function isOwner(slug) {
      return signedIn() && wedding(slug).ownerUid == request.auth.uid;
    }

    function roleDoc(slug) {
      return get(/databases/$(database)/documents/weddings/$(slug)/roles/$(request.auth.uid));
    }

    // A role only counts while it is switched ON. The couple disabling a helper
    // must revoke access immediately, so read `enabled` — never mere existence.
    function roleName(slug) {
      return (signedIn() && roleDoc(slug) != null && roleDoc(slug).data.enabled == true)
        ? roleDoc(slug).data.role
        : "";
    }

    function hasRole(slug, allowed) {
      return isOwner(slug) || (roleName(slug) in allowed);
    }

    // Helpers who may see the guest list but never the money.
    function guestListReader(slug) {
      return hasRole(slug, ["bridesmaid", "mother", "planner"]);
    }

    // ---------- the public wedding document ----------

    match /weddings/{slug} {
      allow read: if true;

      // Creating a wedding: you must stamp yourself as the owner, or you could
      // create a wedding owned by someone else and never be able to edit it —
      // or worse, claim a slug you do not control.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;

      // ownerUid is immutable. Without this, an owner could hand a wedding to
      // an attacker, or an attacker with any write path could seize one.
      allow update: if isOwner(slug)
                    && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isOwner(slug);

      // ---------- guests: the couple's entire contact book ----------

      match /guests/{guestId} {
        allow read: if guestListReader(slug);
        allow write: if isOwner(slug);
      }

      // ---------- invitation code lookup ----------
      //
      // A guest is not signed in and must never read the guest list, but does
      // need to check their own code. So each code gets a tiny public document
      // holding ONLY what the guest may see: their name, seat count, which
      // ceremonies they are invited to, and their table. No phone number, no
      // other guests, nothing about gifts.
      //
      // `get` and `list` are deliberately split. `get` needs the exact six
      // characters, which the guest has on their card. `list` would hand over
      // the whole collection at once, so it stays denied — that difference is
      // the entire protection here.
      //
      // Codes must therefore be RANDOM, never sequential. Six characters from a
      // 32-symbol alphabet is about a billion combinations; ABC001, ABC002 is
      // guessable in an afternoon.

      match /codes/{code} {
        allow get: if true;
        allow list: if false;
        allow write: if isOwner(slug);
      }

      // ---------- invitation requests ----------
      //
      // A shared link is the only workable way to collect a few hundred guests,
      // but an open link is also how a hall fills with people nobody invited.
      // So a request grants NOTHING: no code, no seat, no read access. The
      // couple approves it, and only then is a guest record and code created.
      //
      // Requests are accepted only while the couple has the link switched on,
      // checked here rather than in the page, so switching it off actually
      // stops writes instead of merely hiding a form.

      // The couple may run this in one of two modes, and the difference is only
      // in WHEN a request becomes a guest, never in what a request can do. Auto
      // approval still creates the guest from the couple's own signed-in app,
      // so nothing here grants a stranger a seat by itself.

      match /requests/{id} {
        allow create: if wedding(slug).acceptingRequests == true
                      && wedding(slug).published == true
                      && request.resource.data.keys().hasOnly(
                           ["name", "phone", "seats", "side", "note", "createdAt"])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 1
                      && request.resource.data.name.size() < 120
                      && request.resource.data.phone is string
                      && request.resource.data.phone.size() < 20
                      && request.resource.data.seats is int
                      && request.resource.data.seats > 0
                      && request.resource.data.seats <= 20
                      && request.resource.data.note.size() <= 300;
        // never readable by a guest: it would expose everyone else who asked
        allow read, update, delete: if isOwner(slug);
      }

      // ---------- RSVP drop box ----------
      //
      // Firestore cannot grant a write to a document you cannot read, so the
      // guest writes HERE, keyed by their code, and the responses are merged
      // into the guest record afterwards.
      //
      // The OWNER may read and delete: that is what lets the couple's own app
      // do the merge, with no Cloud Function and therefore no billing account.
      // A guest still cannot read this — it would leak who is attending —
      // and cannot delete anyone's response, including their own.
      //
      // Update is allowed on create-or-update so a guest who changes their mind
      // corrects their own response instead of creating a duplicate.

      match /rsvps/{code} {
        allow create, update: if request.resource.data.keys().hasOnly(
                                   ["code", "responses", "note", "submittedAt"])
                              && request.resource.data.code == code
                              && code.size() == 6
                              && request.resource.data.responses is map
                              && request.resource.data.responses.size() <= 8
                              && request.resource.data.note.size() <= 500;
        allow read, delete: if isOwner(slug);
      }

      // ---------- gifts: owner only ----------
      //
      // Helper roles are deliberately excluded. The mother of the bride can run
      // the guest list without seeing what every guest gave.

      match /gifts/{giftId} {
        allow read: if isOwner(slug);

        // A guest claims a gift they have already transferred, with a receipt.
        // The amount is unverified until the couple confirms it, which is why
        // it never touches the registry total directly.
        allow create: if request.resource.data.keys().hasOnly(
                           ["giver", "code", "amount", "item", "receiptPath", "createdAt"])
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.amount < 100000000
                      && request.resource.data.giver is string
                      && request.resource.data.giver.size() > 0
                      && request.resource.data.giver.size() < 120;

        allow update, delete: if isOwner(slug);
      }

      // ---------- registry: public progress, function-written totals ----------
      //
      // `received` is written by a Cloud Function after the couple confirms a
      // gift. If a client could increment it, anyone could inflate it.

      match /registry/{itemId} {
        allow read: if true;
        allow create, delete: if isOwner(slug);
        allow update: if isOwner(slug)
                      && request.resource.data.received == resource.data.received;
      }

      // ---------- vendors: money, so owner and planner only ----------

      match /vendors/{vendorId} {
        allow read: if hasRole(slug, ["planner"]);
        allow write: if isOwner(slug);
      }

      // ---------- aso-ebi ----------

      match /asoebi/{personId} {
        allow read: if guestListReader(slug);
        allow write: if isOwner(slug);
      }

      // ---------- guest photos ----------
      //
      // Anyone may upload; only approved photos are readable. Approval is the
      // couple's, and an uploader cannot self-approve.

      match /photos/{photoId} {
        allow read: if resource.data.approved == true || isOwner(slug);
        allow create: if request.resource.data.approved == false
                      && request.resource.data.keys().hasOnly(
                           ["storagePath", "uploader", "caption", "approved", "createdAt"]);
        allow update, delete: if isOwner(slug);
      }

      // ---------- roles ----------
      //
      // Owner-only in both directions. A helper must not be able to read the
      // list of roles, discover another PIN, or promote themselves.

      match /roles/{uid} {
        allow read, write: if isOwner(slug);
      }
    }

    // ---------- waitlist (retired) ----------
    //
    // Couples now create their own wedding, so nothing writes here any more.
    // The rule stays create-only so an old cached page cannot fail loudly, and
    // reads stay denied so the addresses collected earlier are never exposed.

    match /signups/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ["names", "phone", "weddingDate", "city",
                          "guestBand", "source", "createdAt"])
                    && request.resource.data.names is string
                    && request.resource.data.names.size() < 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() < 20;
      allow read, update, delete: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
