rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function owner(s) { return request.auth != null && firestore.get(/databases/(default)/documents/weddings/$(s)).data.ownerUid == request.auth.uid; }
  function published(s) { return firestore.get(/databases/(default)/documents/weddings/$(s)).data.published == true; }
  match /weddings/{s}/receipts/{file} {
   allow read, delete: if owner(s);
   allow create, update: if false;
  }
  // Legacy images only. Uploads stay disabled for this no-billing build.
  // Public photo metadata ID MUST match the Storage filename exactly.
  match /weddings/{s}/photos/{file} {
   allow read: if owner(s) || (published(s)
    && firestore.get(/databases/(default)/documents/weddings/$(s)/photos/$(file)).data.approved == true
    && firestore.get(/databases/(default)/documents/weddings/$(s)/photos/$(file)).data.storagePath == 'weddings/' + s + '/photos/' + file);
   allow delete: if owner(s);
   allow create, update: if false;
  }
  match /weddings/{s}/gallery/{file} {
   allow read: if owner(s) || published(s);
   allow delete: if owner(s);
   allow create, update: if false;
  }
  match /{all=**} { allow read, write: if false; }
 }
}
